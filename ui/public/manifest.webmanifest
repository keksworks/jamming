{
  "name": "Jamming.me",
  "short_name": "Jamming",
  "description": "Jam together, in sync",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#141210",
  "theme_color": "#cf3510",
  "icons": [
    {"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
